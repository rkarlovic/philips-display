# Copy to .env and adjust. All values are read at server start.

# HTTP port the server listens on (admin UI at /admin, player at /player).
PORT=8080

# Where the database, media and temp files live. Relative paths are resolved from the repo root.
DATA_DIR=./data

# Secret used to sign the session cookie. Use a long random string (at least 16 characters).
SESSION_SECRET=change-me-to-a-long-random-string

# The single super admin account (university IT). Logs in with email + this password.
SUPERADMIN_EMAIL=it@example.edu
SUPERADMIN_PASSWORD=change-me-please

# Timezone used for all schedules.
TZ=Europe/Zagreb

# Upload limit in MB (used from milestone 2).
MAX_UPLOAD_MB=500

# PDF render resolution (used from milestone 2).
PDF_DPI=150

# Optional: full path to LibreOffice soffice if it is not found automatically.
# SOFFICE_PATH=
