{
  "name": "@slidecast/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=development src/index.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-migrations.mjs",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/multipart": "^9.4.0",
    "@fastify/static": "^8.2.0",
    "@fastify/websocket": "^11.3.7",
    "@napi-rs/canvas": "^0.1.100",
    "@node-rs/argon2": "^2.0.2",
    "@slidecast/shared": "workspace:*",
    "better-sqlite3": "^12.2.0",
    "fastify": "^5.4.0",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "pdfjs-dist": "^5.7.284",
    "sharp": "^0.34.5",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.0",
    "@types/ws": "^8.18.2",
    "tsx": "^4.20.0",
    "vitest": "^3.2.0"
  }
}
